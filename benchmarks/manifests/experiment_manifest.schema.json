{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "enum": [
        1
      ],
      "title": "Schema Version",
      "type": "integer"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Run Id",
      "type": "string"
    },
    "git_sha": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Git Sha"
    },
    "config_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Config Hash",
      "type": "string"
    },
    "dataset_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Dataset Hash",
      "type": "string"
    },
    "corpus_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Hash",
      "type": "string"
    },
    "policy_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Hash",
      "type": "string"
    },
    "provider_revisions": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Provider Revisions",
      "type": "object"
    },
    "hardware": {
      "title": "Hardware",
      "type": "object"
    },
    "seeds": {
      "items": {
        "type": "integer"
      },
      "title": "Seeds",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "artifacts": {
      "items": {
        "type": "string"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "status": {
      "title": "Status",
      "type": "string"
    },
    "missing_runs": {
      "items": {
        "type": "string"
      },
      "title": "Missing Runs",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "config_hash",
    "dataset_hash",
    "corpus_hash",
    "policy_hash",
    "seeds",
    "started_at",
    "status"
  ],
  "title": "ExperimentManifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
