{
  "$defs": {
    "BenchmarkCase": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Id",
          "type": "string"
        },
        "split": {
          "$ref": "#/$defs/Split"
        },
        "source_family_ids": {
          "items": {
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "type": "string"
          },
          "title": "Source Family Ids",
          "type": "array"
        },
        "category": {
          "$ref": "#/$defs/BenchmarkCategory"
        },
        "language": {
          "$ref": "#/$defs/Language"
        },
        "question": {
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "answerable": {
          "title": "Answerable",
          "type": "boolean"
        },
        "gold": {
          "items": {
            "$ref": "#/$defs/BenchmarkGold"
          },
          "title": "Gold",
          "type": "array"
        },
        "gold_paths": {
          "items": {
            "items": {
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
              "type": "string"
            },
            "type": "array"
          },
          "title": "Gold Paths",
          "type": "array"
        },
        "reference_claims": {
          "items": {
            "type": "string"
          },
          "title": "Reference Claims",
          "type": "array"
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewer"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        }
      },
      "required": [
        "id",
        "split",
        "source_family_ids",
        "category",
        "language",
        "question",
        "answerable"
      ],
      "title": "BenchmarkCase",
      "type": "object"
    },
    "BenchmarkCategory": {
      "enum": [
        "single",
        "multihop",
        "cross_source",
        "conflict",
        "code"
      ],
      "title": "BenchmarkCategory",
      "type": "string"
    },
    "BenchmarkGold": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "source_path": {
          "minLength": 1,
          "title": "Source Path",
          "type": "string"
        },
        "raw_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Hash",
          "type": "string"
        },
        "locator": {
          "discriminator": {
            "mapping": {
              "docx": "#/$defs/DocxLocator",
              "markdown": "#/$defs/MarkdownLocator",
              "pdf": "#/$defs/PdfLocator",
              "python": "#/$defs/PythonLocator"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/PdfLocator"
            },
            {
              "$ref": "#/$defs/DocxLocator"
            },
            {
              "$ref": "#/$defs/MarkdownLocator"
            },
            {
              "$ref": "#/$defs/PythonLocator"
            }
          ],
          "title": "Locator"
        },
        "quote": {
          "minLength": 1,
          "title": "Quote",
          "type": "string"
        },
        "grade": {
          "maximum": 3,
          "minimum": 1,
          "title": "Grade",
          "type": "integer"
        },
        "claim_group": {
          "minLength": 1,
          "title": "Claim Group",
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "raw_hash",
        "locator",
        "quote",
        "grade",
        "claim_group"
      ],
      "title": "BenchmarkGold",
      "type": "object"
    },
    "DocxLocator": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "docx",
          "default": "docx",
          "enum": [
            "docx"
          ],
          "title": "Kind",
          "type": "string"
        },
        "block": {
          "minimum": 0,
          "title": "Block",
          "type": "integer"
        },
        "table": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Table"
        },
        "row": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Row"
        },
        "cell": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cell"
        }
      },
      "required": [
        "block"
      ],
      "title": "DocxLocator",
      "type": "object"
    },
    "GoldPathEdge": {
      "additionalProperties": false,
      "properties": {
        "relation_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "title": "Relation Id",
          "type": "string"
        },
        "traversed_reverse": {
          "title": "Traversed Reverse",
          "type": "boolean"
        },
        "evidence_quote_sha256": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Quote Sha256",
          "type": "array"
        }
      },
      "required": [
        "relation_id",
        "traversed_reverse",
        "evidence_quote_sha256"
      ],
      "title": "GoldPathEdge",
      "type": "object"
    },
    "HumanReview": {
      "additionalProperties": false,
      "properties": {
        "reviewer_id": {
          "minLength": 1,
          "title": "Reviewer Id",
          "type": "string"
        },
        "reviewed_at": {
          "format": "date-time",
          "title": "Reviewed At",
          "type": "string"
        },
        "checklist": {
          "$ref": "#/$defs/ReviewChecklist"
        },
        "reviewed_record_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Reviewed Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "reviewer_id",
        "reviewed_at",
        "checklist",
        "reviewed_record_sha256"
      ],
      "title": "HumanReview",
      "type": "object"
    },
    "Language": {
      "enum": [
        "zh",
        "en"
      ],
      "title": "Language",
      "type": "string"
    },
    "MarkdownLocator": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "markdown",
          "default": "markdown",
          "enum": [
            "markdown"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end"
      ],
      "title": "MarkdownLocator",
      "type": "object"
    },
    "PdfLocator": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "pdf",
          "default": "pdf",
          "enum": [
            "pdf"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "minimum": 1,
          "title": "Page",
          "type": "integer"
        },
        "block": {
          "minimum": 0,
          "title": "Block",
          "type": "integer"
        },
        "bbox": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bbox"
        }
      },
      "required": [
        "page",
        "block"
      ],
      "title": "PdfLocator",
      "type": "object"
    },
    "PythonLocator": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "enum": [
            1
          ],
          "title": "Schema Version",
          "type": "integer"
        },
        "kind": {
          "const": "python",
          "default": "python",
          "enum": [
            "python"
          ],
          "title": "Kind",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "line_start": {
          "minimum": 1,
          "title": "Line Start",
          "type": "integer"
        },
        "line_end": {
          "minimum": 1,
          "title": "Line End",
          "type": "integer"
        },
        "qualname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualname"
        },
        "col_start": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col Start"
        },
        "col_end": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Col End"
        }
      },
      "required": [
        "path",
        "line_start",
        "line_end"
      ],
      "title": "PythonLocator",
      "type": "object"
    },
    "ReviewChecklist": {
      "additionalProperties": false,
      "properties": {
        "source_license_verified": {
          "title": "Source License Verified",
          "type": "boolean"
        },
        "quote_verified": {
          "title": "Quote Verified",
          "type": "boolean"
        },
        "locator_verified": {
          "title": "Locator Verified",
          "type": "boolean"
        },
        "answer_and_claim_groups_verified": {
          "title": "Answer And Claim Groups Verified",
          "type": "boolean"
        },
        "gold_paths_verified": {
          "title": "Gold Paths Verified",
          "type": "boolean"
        },
        "answerability_verified": {
          "title": "Answerability Verified",
          "type": "boolean"
        },
        "split_and_family_verified": {
          "title": "Split And Family Verified",
          "type": "boolean"
        }
      },
      "required": [
        "source_license_verified",
        "quote_verified",
        "locator_verified",
        "answer_and_claim_groups_verified",
        "gold_paths_verified",
        "answerability_verified",
        "split_and_family_verified"
      ],
      "title": "ReviewChecklist",
      "type": "object"
    },
    "ReviewedGoldPath": {
      "additionalProperties": false,
      "properties": {
        "edges": {
          "items": {
            "$ref": "#/$defs/GoldPathEdge"
          },
          "minItems": 1,
          "title": "Edges",
          "type": "array"
        }
      },
      "required": [
        "edges"
      ],
      "title": "ReviewedGoldPath",
      "type": "object"
    },
    "Split": {
      "enum": [
        "train",
        "dev",
        "test"
      ],
      "title": "Split",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "case": {
      "$ref": "#/$defs/BenchmarkCase"
    },
    "source_ids": {
      "items": {
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Ids",
      "type": "array"
    },
    "source_record_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Source Record Sha256",
      "type": "array"
    },
    "gold_quote_sha256": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Gold Quote Sha256",
      "type": "array"
    },
    "gold_paths": {
      "items": {
        "$ref": "#/$defs/ReviewedGoldPath"
      },
      "title": "Gold Paths",
      "type": "array"
    },
    "human_review": {
      "$ref": "#/$defs/HumanReview"
    }
  },
  "required": [
    "case",
    "source_ids",
    "source_record_sha256",
    "gold_quote_sha256",
    "human_review"
  ],
  "title": "PreparedBenchmarkCase",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
