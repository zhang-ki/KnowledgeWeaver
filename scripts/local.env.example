# KnowledgeWeaver 可选本地扩展配置模板（非敏感占位）
# 复制到 D:\agent\KnowledgeWeaver\.kw\secrets\local.env（已在 .gitignore 中忽略），start-kw.ps1 会自动加载。

# 默认语料库 UUID（可选；如与 KnowSphere 个人空间联动，可填你的 personalSpaceId）
# KW_CORPUS_ID=02f86e70-2d2e-4142-9389-3c1ac0b9bd86

# 允许导入的本地文档目录（Windows 多目录用分号 ; 分隔；不存在会自动创建）
# KW_ALLOWED_ROOTS=D:\agent\KnowledgeWeaver\my_docs

# 本地 Embedding 模型（如本机 Ollama / llama.cpp OpenAI 兼容回环接口）
# KW_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# KW_EMBEDDING_MODEL=qwen3-embedding

# 本地对话模型（可选）
# KW_LOCAL_CHAT_URL=http://127.0.0.1:11434/v1/chat/completions
# KW_LOCAL_CHAT_MODEL=qwen3

# 如需调用远端兼容 OpenAI 的模型（默认关闭，仅用户显式启用时填写）
# KW_ALLOW_REMOTE=false
# KW_MODEL_OFFLINE=true
# KW_LLM_BASE_URL=
# KW_LLM_MODEL=
# KW_LLM_API_KEY=
