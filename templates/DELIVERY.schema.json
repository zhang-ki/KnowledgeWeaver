{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "task_id",
    "plan_version",
    "base_commit",
    "head_commit",
    "changed_files",
    "tests",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "plan_version": {
      "const": "KW-P0-2026-11-18"
    },
    "base_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code",
          "artifact_hash"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "artifact_hash": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "artifacts": {
      "type": "array"
    },
    "limitations": {
      "type": "array"
    }
  }
}
